{
    "name": "onepetdev/mandrill-api-php",
    "type": "library",
    "description": "A PHP client library for Mandrill's REST API",
    "keywords": ["mandrill"],
    "license": "MIT",
    "authors": [
        {
            "name": "OnePetDev",
            "homepage": "https://github.com/OnePetDev"
        }
    ],
    "require": {
        "php": ">=5.3.2",
        "guzzle/guzzle": "3.*"
    },
    "require-dev": {
        "phpunit/phpunit": "3.7.*"
    },
    "autoload": {
        "psr-4": {
            "OnePetDev\\": "src/OnePetDev/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OnePetDev\\Mandrill\\Tests\\": "tests/OnePetDev/Tests/"
        }
    }
}
